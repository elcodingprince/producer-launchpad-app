{
  "name": "producer-launchpad",
  "version": "1.0.0",
  "description": "Shopify Embedded App for music producers to upload beats with automatic metafield configuration",
  "private": true,
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "dev:web": "sh -c 'remix vite:dev --host 0.0.0.0 --port ${PORT:-5173}'",
    "push": "shopify app push",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "env:use:local": "node ./scripts/use-env.mjs .env.local",
    "start": "HOST=0.0.0.0 remix-serve ./build/server/index.js",
    "setup": "npm run db:generate && npm run db:migrate:dev",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-email/components": "^1.0.9",
    "@react-email/render": "^2.0.4",
    "@react-pdf/renderer": "^4.3.2",
    "@remix-run/dev": "^2.8.0",
    "@remix-run/node": "^2.8.0",
    "@remix-run/react": "^2.8.0",
    "@remix-run/serve": "^2.8.0",
    "@shopify/app-bridge-react": "^4.2.10",
    "@shopify/polaris": "^12.20.0",
    "@shopify/polaris-icons": "^8.11.0",
    "@shopify/shopify-api": "^13.0.0",
    "@shopify/shopify-app-remix": "^4.2.0",
    "@shopify/shopify-app-session-storage-memory": "^6.0.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "@shopify/ui-extensions": "^2025.7.3",
    "@shopify/ui-extensions-react": "^2025.7.3",
    "archiver": "^7.0.1",
    "isbot": "^5.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-reconciler": "0.29.0",
    "resend": "^6.9.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@remix-run/eslint-config": "^2.8.0",
    "@shopify/api-codegen-preset": "^1.0.1",
    "@types/eslint": "^8.56.6",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "prisma": "^6.19.0",
    "typescript": "^5.4.2",
    "vite-plugin-tsconfig-paths": "^1.4.1"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "resolutions": {
    "@graphql-tools/url-loader": "8.0.2"
  },
  "overrides": {
    "@graphql-tools/url-loader": "8.0.2"
  },
  "engines": {
    "node": "^20.10 || ^22.0"
  },
  "browserslist": [
    "defaults"
  ]
}
