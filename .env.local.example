# Local-only runtime env for `npm run dev`
# Copy this file to `.env.local`, then activate it with:
# npm run env:use:local

# Shopify API credentials for your non-production app
SHOPIFY_API_KEY=your_non_production_api_key
SHOPIFY_API_SECRET=your_non_production_api_secret
SHOPIFY_APP_URL=https://your-non-production-app-url.example.com
SHOPIFY_APP_SCOPES=read_products,write_products,read_publications,write_publications,read_metaobjects,write_metaobjects,read_metaobject_definitions,write_metaobject_definitions,read_orders,write_app_proxy
SHOPIFY_APP_HANDLE=your-app-handle
SHOPIFY_BILLING_REQUIRED=false

# Session secret
SESSION_SECRET=your_random_session_secret_here

# Cloudflare R2 configuration
CF_R2_ACCOUNT_ID=your-account-id
CF_R2_BUCKET_NAME=your-bucket-name
CF_R2_ACCESS_KEY_ID=your-access-key-id
CF_R2_SECRET_ACCESS_KEY=your-secret-access-key
CF_R2_PUBLIC_BASE_URL=

# Use the Neon branch you want local dev to talk to.
# If local and staging should share one DB, paste the staging branch connection string here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional shadow DB for Prisma migrate dev
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST/SHADOW_DATABASE?sslmode=require"

# Email configuration
RESEND_API_KEY=re_your_resend_api_key
DELIVERY_EMAIL_FROM="Producer Launchpad <downloads@example.com>"
DELIVERY_EMAIL_REPLY_TO=support@example.com
DELIVERY_EMAIL_BRAND_NAME=Producer Launchpad
RESEND_WEBHOOKS_ENABLED=false
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# Internal-only testing routes
ENABLE_INTERNAL_TEST_ROUTES=false
